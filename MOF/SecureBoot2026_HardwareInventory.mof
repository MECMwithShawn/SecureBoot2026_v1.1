    [SMS_Report(TRUE)] string UEFICA2023ErrorHex;
    [SMS_Report(TRUE)] string AvailableUpdatesHex;
    [SMS_Report(TRUE)] string WindowsUEFICA2023Capable;
    [SMS_Report(TRUE)] string ConfidenceLevel;
    [SMS_Report(TRUE)] string BitLockerProtectionStatus;
    [SMS_Report(TRUE)] string LatestSecureBootEventId;
    [SMS_Report(TRUE)] string StatusCategory;
